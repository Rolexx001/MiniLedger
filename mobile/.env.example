# Backend API URL for MiniLedger
# For Web preview or local testing:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# For Android Emulator (10.0.2.2 maps to host machine localhost):
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# For Physical Device (replace with your computer's local Wi-Fi IP address):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:5000/api
